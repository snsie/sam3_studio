# HiPerGator configuration template; safe to track in Git.
# Copy to backend/.env on HiPerGator and replace GROUP, USER, and asset names.
# Run the backend inside a Slurm GPU allocation.
SAM3_DEVICE=cuda
SAM3_WORKER_COUNT=1
SAM3_LOAD_FROM_HF=false
SAM3_CHECKPOINT_PATH=/blue/GROUP/USER/models/checkpoint.pt
SAM3_BPE_PATH=/blue/GROUP/USER/models/bpe.model
SAM3_COMPILE=false
SAM3_MAX_CACHED_SESSIONS=8
SAM3_QUEUE_MAX_SIZE=0
SAM3_REQUEST_TIMEOUT_SECONDS=300
SAM3_CONFIDENCE_THRESHOLD=0.5

# Persistent data; independent paths must each be set explicitly.
DATA_DIR=/blue/GROUP/USER/sam3_studio/data
CHALLENGE_DATASETS_DIR=/blue/GROUP/USER/sam3_studio/data/datasets
UPLOADS_DIR=/blue/GROUP/USER/sam3_studio/data/uploads
LEADERBOARD_DB_PATH=/blue/GROUP/USER/sam3_studio/data/leaderboard.sqlite3

# Local browser access over an SSH tunnel.
FRONTEND_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
